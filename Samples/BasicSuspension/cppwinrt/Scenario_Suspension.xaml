<Page
    x:Class="SDKTemplate.Scenario_Suspension"
    xmlns:local="using:SDKTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ListView x:Name="list" Header="Click on an item or click a button in the AppBar."
            EntranceNavigationTransitionInfo.IsTargetElement="True"
            IsItemClickEnabled="True" ItemClick="ListView_ItemClick"
            ItemsSource="{x:Bind Path=Items, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:Item">
                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Margin="12,4" Text="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Label="add" Icon="Add" Click="{x:Bind AddItem}"/>
            <AppBarButton Label="reset" Icon="Refresh" Click="{x:Bind ResetItems}"/>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
