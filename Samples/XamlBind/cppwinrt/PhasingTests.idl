namespace SDKTemplate
{
    [bindable]
    runtimeclass FileItem
    {
        FileItem(xBindSampleModel.FileItem item);

        Windows.UI.Xaml.Media.Imaging.BitmapImage ImageData { get; };
        String DisplayName { get; };
        String prettyDate { get; };
        String prettyFileSize { get; };
        String prettyImageSize { get; };
    };

    [default_interface]
    runtimeclass PhasingTests : Windows.UI.Xaml.Controls.Page
    {
        PhasingTests();

        void Reset_Click(IInspectable sender, Windows.UI.Xaml.RoutedEventArgs e);
        void ChangeFolderClick(IInspectable sender, Windows.UI.Xaml.RoutedEventArgs e);
        void SlowPhasing_UnChecked(IInspectable sender, Windows.UI.Xaml.RoutedEventArgs e);
        void SlowPhasing_Checked(IInspectable sender, Windows.UI.Xaml.RoutedEventArgs e);
        void PhasedTemplate_Checked(IInspectable sender, Windows.UI.Xaml.RoutedEventArgs e);
    };
}
