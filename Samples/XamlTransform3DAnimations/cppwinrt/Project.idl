namespace Transform3DAnimations
{
    namespace ViewModels
    {
        runtimeclass ArticleViewModel
        {
            ArticleViewModel();

            String Headline;
            Windows.UI.Xaml.Media.ImageSource ImageSource { get; };
            String FullText { get; };
        }

        runtimeclass HeroArticlesViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
        {
            HeroArticlesViewModel();

            Transform3DAnimations.ViewModels.ArticleViewModel Article0;
            Transform3DAnimations.ViewModels.ArticleViewModel Article1;
        }
    }

    runtimeclass ArticlePage : Windows.UI.Xaml.Controls.Page
    {
        ArticlePage();

        Transform3DAnimations.ViewModels.ArticleViewModel Article;
        Windows.UI.Xaml.Controls.RichTextBlockOverflow TextBlock1 { get; };

