    }

    runtimeclass SectionView : Windows.UI.Xaml.Controls.UserControl
    {
        SectionView();

        Transform3DAnimations.ViewModels.HeroArticlesViewModel ViewModel;

        void OnViewModelChanged(
                Transform3DAnimations.ViewModels.HeroArticlesViewModel oldValue,
                Transform3DAnimations.ViewModels.HeroArticlesViewModel newValue);

