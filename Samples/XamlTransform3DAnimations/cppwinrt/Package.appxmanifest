<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest" xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10" IgnorableNamespaces="uap mp">
  <Identity
    Name="Microsoft.SDKSamples.Transform3DAnimations.CPP"
    Publisher="CN=migue"
    Version="1.0.0.0" />
  <mp:PhoneIdentity PhoneProductId="1c3c4e2e-b0f9-43b3-b26c-272a8e725919" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>
  <Properties>
      <DisplayName>Transform3D Animations C++/WinRT Sample</DisplayName>
    <PublisherDisplayName>Microsoft</PublisherDisplayName>
    <Logo>Assets/storelogo-sdk.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.0.0" MaxVersionTested="10.0.0.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="XamlTransform3DAnimations.App">
      <uap:VisualElements
        DisplayName="Transform3D Animations C++/WinRT Sample"
        Square150x150Logo="Assets/squaretile-sdk.png"
        Square44x44Logo="Assets/smalltile-sdk.png"
        Description="Transform3D Animations C++/WinRT Sample"
        BackgroundColor="#00b2f0">
        <uap:SplashScreen Image="Assets/splash-sdk.png" />
        <uap:DefaultTile
            Wide310x150Logo="Assets/Wide310x150Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
